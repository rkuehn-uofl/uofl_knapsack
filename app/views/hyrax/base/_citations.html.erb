<%# UOFL OVERRIDE: Hyrax's default partial renders a "Citations:" export
    dropdown (EndNote/Zotero/Mendeley). UofL doesn't want it, so the
    dropdown is removed entirely. Copy permalink button mirrors Hyrax 5.3;
    it only shows when the copy_permalink_button feature is on. %>
<div class="citations">
    <%= render 'hyrax/shared/copy_permalink', presenter: presenter %>
    <% if Hyrax.config.citations? %>
      <%= link_to t(".citations"), hyrax.citations_work_path(presenter), id: 'citations', class: 'btn btn-secondary btn-sm mr-2' %>
    <% end %>
</div>
