  <% end %> 

  <div id="filters-adv">
    <% if show_header_facets %>
      <button class="openbtn2" type="button" aria-haspopup="dialog" aria-controls="mySidebar2" aria-expanded="false" onclick="openNav(this)"><i class="fa-solid fa-arrow-down-wide-short"></i> <%= search_results_page ? 'Filter' : 'Browse' %> </button>
    <% end %>

    <a class="btn" id="advanced-search-link2" href="/advanced"><i class="fa-solid fa-up-right-from-square"></i> Advanced <span class="sr-only">search page</span></a>
</div>

<%# #mySidebar2 renders on every page (not gated by show_header_facets) - the
    homepage hero's own "Browse Items" button calls openNav() directly and
    needs the dialog to exist regardless of whether the compact header
    button above is shown. hyrax/homepage/facets self-guards on
    has_facet_values?, so this is an empty shell on pages with no facets. %>
<dialog id="mySidebar2" class="filter-drawer" aria-labelledby="filter-title">
  <div class="drawer-panel filter-panel">
    <button class="drawer-close" type="button" onclick="closeNav()" aria-label="Close filters"></button>
    <p class="eyebrow">Refine Results</p>
    <h2 id="filter-title"><%= search_results_page ? 'Filter' : 'Browse' %></h2>
    <p>Browse or filter your results.</p>
    <%= render 'hyrax/homepage/facets' %>
  </div>
</dialog>


<script>
(function () {
  var sidebar = document.getElementById("mySidebar2");
  if (!sidebar) return;

  var filterDrawerTrigger = null;

  window.openNav = function (trigger) {
    filterDrawerTrigger = trigger || document.activeElement;
    sidebar.showModal();
    document.body.style.overflow = "hidden";
    if (filterDrawerTrigger) filterDrawerTrigger.setAttribute("aria-expanded", "true");
  };

  window.closeNav = function () {
    sidebar.close();
  };

  // Fires for every close path - the close button's onclick, Escape (which
  // <dialog> handles natively), and the backdrop click below - so cleanup
  // only needs to live in one place.
  sidebar.addEventListener("close", function () {
    document.body.style.overflow = "";
    if (filterDrawerTrigger) {
      filterDrawerTrigger.setAttribute("aria-expanded", "false");
      filterDrawerTrigger.focus();
      filterDrawerTrigger = null;
    }
  });

  sidebar.addEventListener("click", function (event) {
    if (event.target === sidebar) sidebar.close();
  });
})();
</script>
