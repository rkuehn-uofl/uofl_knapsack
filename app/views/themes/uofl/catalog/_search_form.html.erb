<script>
function openNav() {
  document.getElementById("mySidebar2").style.width = "90%";
  document.getElementById("main2").style.marginRight = "90%";
}

function closeNav() {
  document.getElementById("mySidebar2").style.width = "0";
  document.getElementById("main2").style.marginRight= "0";
}
