<%# The header Browse/Filter button should appear on every public page (same
    "public-facing" test the layout uses to add the body class in
    layouts/hyrax.html.erb) - not just the homepage and catalog search. It was
    previously allow-listed to just those two, which silently dropped it from
    collection show, work show, and the advanced search page. %>
<% show_header_facets = !params[:controller].to_s.match?(/\Aproprietor/) %>
<%# "Filter" only makes sense as a label on the search-results page (you're
    refining an existing result set); everywhere else (homepage, collection
    show, work show, advanced search, ...) this opens the same drawer to
    browse, so it reads "Browse" there instead. %>
<% search_results_page = controller_path == 'catalog' && action_name == 'index' %>

<%= form_tag search_form_action, method: :get, class: ["search-form", ("has-query" if current_search_parameters.present?)].compact.join(" "), id: "search-form-header", role: "search" do %>
  <%= render Blacklight::HiddenSearchStateComponent.new(params: search_state.params_for_search.except(:q, :search_field, :qt, :page, :utf8)) %>
  <%= hidden_field_tag :search_field, 'all_fields' %>
  
    <%= text_field_tag :q, current_search_parameters , 'aria-label': 'Search', class: "q form-control", id: "search-input-header", placeholder: t("hyrax.search.form.q.placeholder"), oninput: "this.form.classList.toggle('has-query', this.value.length > 0)" %>

   <button type="submit" class="btn btn-primary search-submit-button" id="search-submit-header">
          <label for="search-input-header">search</label>
          <div class="search-icon"></div>
    </button>

  <!-- div class="form-group row pt-4 pt-sm-0" id="staff-search-dropdown-wrap">

        
        <% if current_user %>
          <button class="btn btn-secondary dropdown-toggle" id="user-works-dropdown" type="button" data-toggle="dropdown" aria-expanded="false">

            <span class="sr-only" data-search-element="label"><%= t("hyrax.search.form.option.all.label_long", application_name: application_name) %></span>
            <span aria-hidden="true"><%= t("hyrax.search.form.option.all.label_short") %></span>
          </button>



          <div class="dropdown-menu dropdown-menu-right" id="staff-search-dropdown-content">
            <%= link_to t("hyrax.search.form.option.all.label_long", application_name: application_name), "#", class: "dropdown-item",
                data: { "search-option" => main_app.search_catalog_path, "search-label" => t("hyrax.search.form.option.all.label_short") } %>
            <%= link_to t("hyrax.search.form.option.my_works.label_long"), "#", class: "dropdown-item",
                data: { "search-option" => hyrax.my_works_path, "search-label" => t("hyrax.search.form.option.my_works.label_short") } %>
