    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=University+of+Louisville+Kornhauser+Health+Sciences+Library&locale=en">Kornhauser Health Sciences Library</a>
    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=Law+Library+of+the+Louis+D.+Brandeis+School+of+Law%2C+University+of+Louisville&locale=en">Law Library, Louis D. Brandeis School of Law</a>
