<%# UOFL OVERRIDE: UofL Theme - Header ported from the new hyku-home design
    (mega-menu nav), rendered on every page. Real data: Popular Collections,
    Repositories, Explore By Type/Places all link to real facet searches or
    real collections.

    catalog/_search_form always renders here (not just on non-hero pages):
    it's what defines #mySidebar2 (the real facets drawer) and the openNav()/
    closeNav() functions that the homepage hero's own "Browse Items" button
    calls. On hero pages (body.has-hero) the visible compact search box/
    buttons are hidden via CSS instead of skipping the render, so the drawer
    and its JS stay available everywhere. %>

<header class="site-header" id="header-navbar" aria-label="header" data-header>
  <a class="brand" href="/" aria-label="<%= application_name %> home">
    <img alt="University of Louisville Libraries" src="<%= image_path('themes/uofl/logo/logo-libraries-ALT_black-trimmed.png') %>">
    <span>Digital Collections</span>
  </a>

  <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-mobile-toggle>
    <span></span>
    <span></span>
    <span></span>
    <span class="sr-only">Toggle navigation</span>
  </button>

  <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
    <div class="nav-item">
      <button class="nav-trigger" type="button" aria-expanded="false" data-menu="collections">Collections <i class="fa-solid fa-chevron-down"></i></button>
    </div>
    <div class="nav-item">
      <button class="nav-trigger" type="button" aria-expanded="false" data-menu="repositories">Repositories <i class="fa-solid fa-chevron-down"></i></button>
    </div>
    <div class="nav-item">
      <button class="nav-trigger" type="button" aria-expanded="false" data-menu="explore">Explore <i class="fa-solid fa-chevron-down"></i></button>
    </div>
    <div class="nav-item">
      <button class="nav-trigger" type="button" aria-expanded="false" data-menu="help">Help <i class="fa-solid fa-chevron-down"></i></button>
    </div>
  </nav>

  <div id="header-search-wrap">
    <%= render 'catalog/search_form' %>
  </div>
</header>

<div class="mega-menu collections" data-panel="collections" aria-hidden="true">
  <img alt="boy reading with bookmobile behind him" src="<%= image_path('themes/uofl/header/SONJ_51793_n_250s.png') %>">
  <div>
    <p class="eyebrow">Popular Collections</p>
    <a href="fake.html">Caufield &amp; Shook Collection</a>
    <a href="fake.html">Standard Oil (New Jersey) Collection</a>
    <a href="fake.html">Louisville Leader Collection</a>
    <a href="fake.html">Royal Photo Company Collection</a>
    
    <!--
    <% uofl_navbar_collections = uofl_top_collections %>
    <% uofl_navbar_collections.each do |collection| %>
      <%= link_to markdown(collection.title_or_label), hyrax.collection_path(collection.id) %>
    <% end %>
    -->
  </div>
  <div>
    <p class="eyebrow">Browse Collections</p>
    <a href="/all_collections">View all collections with descriptions</a>
  </div>
</div>

<div class="mega-menu repositories" data-panel="repositories" aria-hidden="true">
  <img alt="two women talking 1920" src="<%= image_path('themes/uofl/header/CS_033312_c_pt_250s.png') %>">
  <div>
    <p class="eyebrow">Repositories</p>
    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=University+of+Louisville+Photographic+Archives&locale=en">ASC Photographic Archives</a>
    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=University+of+Louisville+Rare+Books&locale=en">ASC Rare Books</a>
    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=University+of+Louisville+Archives+and+Records+Center&locale=en">ASC University Archives &amp; Records Center</a>
    <a href="/catalog?f%5Bpublisher_sim%5D%5B%5D=University+of+Louisville+Margaret+M.+Bridwell+Art+Library&locale=en">Bridwell Art Library</a>
