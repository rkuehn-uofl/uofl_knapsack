<div class="mega-menu explore" data-panel="explore" aria-hidden="true">
  <img alt="Historic map detail" src="<%= image_path('themes/uofl/header/SONJ_58546_n_250s.png') %>">
  <div>
    <p class="eyebrow">Explore By Type</p>
    <a href="<%= main_app.search_catalog_path(f_inclusive: { resource_type_sim: ['Film negatives', 'Gelatin silver printing-out paper prints', 'Gelatin silver prints', 'Glass negatives', 'Halftone photomechanical prints', 'Nitrate negatives', 'Photographic postcards', 'Photographic prints', 'Photogravures', 'Photomechanical prints', 'Stereographs'] }) %>">Photographs</a>
