<div class="mega-menu help" data-panel="help" aria-hidden="true">
  <img alt="librarian helping students in the University Library" src="<%= image_path('themes/uofl/header/001_0435_300x300.jpg') %>">
  <div>
    <p class="eyebrow">Help</p>
    <a href="fake.html">Search the Digital Collections</a>
    <a href="fake.html">Navigate multi-page objects</a>
    <a href="fake.html">Cite sources</a>
    <a href="fake.html">Order reproductions</a>
  </div>
  <div>
    <p class="eyebrow">Need more help?</p>
    <a href="mailto:digital@louisville.edu">Email us</a>
    <a href="tel:5028524476">Call 502.852.4476</a>
  </div>
</div>

<script>
  (function () {
    const navTriggers = document.querySelectorAll('.nav-trigger');
    const megaMenus = document.querySelectorAll('.mega-menu');
    const mobileToggle = document.querySelector('[data-mobile-toggle]');
    const primaryNav = document.querySelector('.primary-nav');

    function closeMenus() {
      navTriggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      megaMenus.forEach((menu) => {
        menu.classList.remove('is-open');
        menu.setAttribute('aria-hidden', 'true');
      });
    }

    const header = document.querySelector('.site-header');

    navTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const panel = document.querySelector(`[data-panel="${trigger.dataset.menu}"]`);
        const wasOpen = panel.classList.contains('is-open');
        closeMenus();

        if (!wasOpen) {
          // .mega-menu panels are siblings of .site-header (not children), so a
          // CSS `top: 100%` would resolve against the document, not the header.
          // Position it against the header's actual rendered height instead.
          if (header) panel.style.top = `${header.getBoundingClientRect().bottom}px`;
          trigger.setAttribute('aria-expanded', 'true');
          panel.classList.add('is-open');
          panel.setAttribute('aria-hidden', 'false');
        }
      });
    });

    document.addEventListener('click', (event) => {
      const clickedMenu = event.target.closest('.mega-menu');
      const clickedTrigger = event.target.closest('.nav-trigger');

      if (!clickedMenu && !clickedTrigger) {
        closeMenus();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenus();
    });

    if (mobileToggle && primaryNav) {
      mobileToggle.addEventListener('click', () => {
        const isOpen = primaryNav.classList.toggle('is-open');
        mobileToggle.setAttribute('aria-expanded', String(isOpen));
      });
    }

    // The header is position:absolute (so it can float over the homepage/
    // all_collections hero), which takes it out of normal flow - on every
    // other page #content-wrapper needs real padding-top to compensate, or
    // the header covers the page title/breadcrumbs. A fixed CSS value can't
    // work here because the header's actual height varies (it wraps to a
    // second row once the search box + Browse/Filter + Advanced buttons
    // don't fit on one line), so measure it for real instead.
    const contentWrapper = document.getElementById('content-wrapper');

    function syncContentPadding() {
      if (!header || !contentWrapper || document.body.classList.contains('has-hero')) return;
      contentWrapper.style.paddingTop = `${header.offsetHeight}px`;
    }

    syncContentPadding();
    window.addEventListener('resize', syncContentPadding);
    window.addEventListener('load', syncContentPadding);
  })();
</script>
