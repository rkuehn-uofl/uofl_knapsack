<%# UOFL OVERRIDE: UofL Theme - Footer ported from the new hyku-home design
    (plain grid, not a dark rounded box). Real content: contact info, terms/
    about/accessibility links, copyright/version, and real admin/user util
    links. %>
<% current_year = Time.now.year %>

<footer class="site-footer">
  <img alt="University of Louisville Libraries" src="<%= image_path('themes/uofl/logo-libraries-ALT_black-trimmed.png') %>">

  <p>
    <a href="https://library.louisville.edu/home">University of Louisville Libraries</a><br>
    <a href="https://library.louisville.edu/archives/di">Digital Initiatives</a><br>
    <a href="tel:5028524476" aria-label="502.852.4476">502.852.4476</a><br>
    <a href="mailto:digital@louisville.edu">Email</a>
  </p>

  <nav aria-label="Footer links">
    <a href="/about?locale=en">About the Project</a>
    <a href="/terms?locale=en">Terms of Use</a>
    <a href="https://library.louisville.edu/archives/digcoll/accessibility">Accessibility Statement</a>
  </nav>

  <div class="footer-meta">
    <p>
      <%= t('hyrax.footer.copyright_html', current_year: current_year) %><br>
      <%= t('hyrax.background_attribution_html') %><br>
      Hyku v<%= Hyku::VERSION %> with Hyrax v<%= Hyrax::VERSION %><br>
      <%= t('hyrax.footer.service_html') %> <%= ENV.fetch('HYKU_FOOTER_EXTRA', '').html_safe %>
    </p>
    <%# admin_util_links/user_util_links render a <ul> (block content), which
        an enclosing <p> can't legally contain - the browser would silently
        close the <p> early and the login link would end up outside the
        footer's grid layout entirely. Keep this in a <div>, not a <p>. %>
    <div class="utility-nav" aria-label="User links">
      <% if admin_host? %>
        <%= render '/admin_util_links' %>
      <% else %>
        <%= render '/user_util_links' %>
      <% end %>
    </div>
  </div>
</footer>
