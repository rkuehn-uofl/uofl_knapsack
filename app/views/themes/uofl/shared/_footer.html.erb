<% current_year = Time.now.year %>


<footer>
  <div id="footer2026">
    <div id="foot1">
      <div id="foot-contact">
        <p><a href="https://library/louisvill.edu">University of Louisville Libraries</a></p>
        <p><a href="https://library.louisville.edu/archives/di">Digital Initiatives</a></p>
        <p><a href="tel:5028524476" aria-label="502.852.4476">502.852.4476</a></p>
        <p><a href="mailto:digital@louisville.edu">Email</a></p>
      </div>
      <div id="foot-more">
        <p><a href="/about?locale=en">About the Project</a></p>
        <p><a href="/terms?locale=en">Terms of Use</a></p>
        <p><a href="https://library.louisville.edu/archives/digcoll/accessibility">Accessibility Statement</a></p>

      </div>
    </div>
    <div id="foot2">
      <div id="system-info">
        <p> <%= t('hyrax.footer.copyright_html', current_year: current_year) %></p>
        <p><%= t('hyrax.background_attribution_html') %></p>
        <p>Hyku v<%= Hyku::VERSION %> with Hyrax v<%= Hyrax::VERSION %></p>
        <p><%= t('hyrax.footer.service_html') %> <%= ENV.fetch('HYKU_FOOTER_EXTRA', '').html_safe %></p>
      </div>
      <div id="staff-login">
        <div class="justify-content-end" id="footer-login">
		  <% if admin_host? %>
		  <%= render '/admin_util_links' %>
		  <% else %>
		  <%= render '/user_util_links' %>
		  <% end %>
	      </div>
      </div>
    </div>

  </div>

</footer>

