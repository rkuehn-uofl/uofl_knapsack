<%# UOFL OVERRIDE Hyrax 5.2.0: use Blacklight's own dropdown component -- the same
    button + dropdown-menu widgets /catalog uses -- for "Sort by" and "Results per
    page" instead of a <select> inside a <form>, whose native browser behavior
    (implicit submit-on-Enter, OS-rendered popup) is unpredictable across
    browsers/AT. Both dropdowns navigate directly on choice (like catalog's), so
    the <form>/Refresh button that used to submit the old selects is gone too --
    catalog's own sort/per-page controls don't have one either.

    Choices come from blacklight_config.per_page (set in
    CatalogControllerDecorator.configure_uofl_per_page), not
    Hyrax.config.range_for_number_of_results_to_display_per_page -- that global
    also drives the internal dashboard's My Works/My Collections per-page
    pickers, which weren't part of the public-page slowdown this caps. %>
<% if show_sort_and_per_page? && collection_member_sort_fields.many? %>
  <div class="per_page form-horizontal">
    <%= render 'view_type_group' %>
    <fieldset class="float-left">
      <legend class="sr-only"><%= t('hyrax.sort_label') %></legend>
      <%= render Blacklight::Response::SortComponent.new(
                   search_state: search_state,
                   choices: collection_member_sort_fields.map { |key, field| [field.label, key] },
                   selected: params[:sort]
                 ) %>
      <span class="sr-only"><%= t('blacklight.search.per_page.title') %></span>
      <%= render Blacklight::System::DropdownComponent.new(
                   param: 'per_page',
                   choices: blacklight_config.per_page.map { |count| [t('blacklight.search.per_page.label', count: count).html_safe, count] },
                   search_state: search_state,
                   selected: params[:per_page].presence&.to_i,
                   interpolation: :count
                 ) %>
    </fieldset>
  </div>
<% end %>
