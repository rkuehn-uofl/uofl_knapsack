<%# UOFL OVERRIDE Hyrax 5.2.0: use Blacklight's own sort dropdown component -- the
    same button + dropdown-menu widget /catalog uses -- for "Sort by" instead of a
    <select> inside a <form>, whose native browser behavior (implicit
    submit-on-Enter, OS-rendered popup) is unpredictable across browsers/AT.
    "Results per page" stays a <select> (guarded against the implicit-submit-on-Enter
    behavior) since it's a simple numeric choice submitted via the Refresh button. %>
<% no_enter_submit = { onkeydown: "if(event.key === 'Enter'){ event.preventDefault(); }" } %>
<% if show_sort_and_per_page? && collection_member_sort_fields.many? %>
  <%= form_tag collection_path(collection), method: :get, class: 'per_page form-horizontal' do %>
    <%= render 'view_type_group' %>
    <fieldset class="float-left">
      <legend class="sr-only"><%= t('hyrax.sort_label') %></legend>
      <%= render Blacklight::Response::SortComponent.new(
                   search_state: search_state,
                   choices: collection_member_sort_fields.map { |key, field| [field.label, key] },
                   selected: params[:sort]
                 ) %>
      <%= label_tag(:per_page) do %>
        <span class="tiny-nudge"><%= t('.results_per_page') %></span>
        <%= select_tag(:per_page, options_for_select(Hyrax.config.range_for_number_of_results_to_display_per_page, h(params[:per_page])), title: t('.number_of_results_to_display_per_page'), **no_enter_submit) %>
      <% end %>
      <%= render Blacklight::HiddenSearchStateComponent.new(params: search_state.params_for_search.except(:per_page, :sort)) %>
      &nbsp;<button class="btn btn-sm btn-secondary tiny-nudge"><span class="fa fa-refresh"></span> <%= t('helpers.action.refresh') %></button>
    </fieldset>
  <% end %>
<% end %>
