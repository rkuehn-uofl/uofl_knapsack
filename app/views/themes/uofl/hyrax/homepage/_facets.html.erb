<%# UOFL OVERRIDE: UofL Theme - Render facets on the UofL homepage. %>

<% if @response.present? && has_facet_values? %>
  <div id="facets" class="facets sidenav">
    <div class="facets-header">
      <h2 class="facets-heading">
        <%= controller_name == "homepage" ? "Browse" : "Filter Results" %>
      </h2>
    </div>

    <div id="facet-panel-collapse" class="facets-collapse">
      <%= render_facet_partials %>
    </div>
  </div>
<% end %>