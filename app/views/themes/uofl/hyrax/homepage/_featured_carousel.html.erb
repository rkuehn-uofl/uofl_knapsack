<%# UOFL OVERRIDE: UofL Theme - Curated "Featured Theme" carousel. Each
    theme's heading, description, and "Explore this theme" search link are
    hand-written by a curator in config/uofl_featured_carousel_themes.yml;
    each theme's image links to one specific work, and that work's item
    number/link are looked up live from Solr (see
    UoflHomepageHelper#uofl_featured_carousel_slides) so they can't go
    stale. This is separate from the "Browse Collections" grid further down
    the page, which is still driven by the real, admin-curated Featured
    Collections list.

    Takes `slides` and `carousel_id` as locals (rather than computing its
    own slides) so the same markup/JS can render more than once on a page -
    e.g. the signed-in-only carousel preview page renders one instance per
    configured group - without id collisions. %>
<% slides = local_assigns.fetch(:slides) %>
<% carousel_id = local_assigns.fetch(:carousel_id) %>
<% if slides.present? %>
  <section class="feature-carousel" aria-label="Featured theme" id="<%= carousel_id %>">
    <div class="carousel-copy">
      <p class="eyebrow">Featured Theme</p>
      <h2 data-slide-title><%= slides.first[:title] %></h2>
      <p data-slide-description><%= slides.first[:description] %></p>
      <a class="button-link" data-slide-link href="<%= slides.first[:search_url] %>">Explore this theme <i class="fa-solid fa-arrow-right-long"></i></a>

      <% if slides.size > 1 %>
        <div class="carousel-controls" aria-label="Carousel controls">
          <button type="button" data-carousel-prev aria-label="Previous featured theme item"><i class="fa-solid fa-chevron-left"></i></button>
          <div class="carousel-dots" data-carousel-dots>
            <% slides.each_with_index do |slide, index| %>
              <button type="button" class="<%= 'is-active' if index.zero? %>" data-slide-index="<%= index %>" aria-label="Show <%= slide[:title] %>"></button>
            <% end %>
          </div>
          <button type="button" data-carousel-next aria-label="Next featured theme item"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
      <% end %>
    </div>
    <div class="carousel-image-wrap">
      <a class="item-pill" data-slide-item-link href="<%= slides.first[:item_url] %>"><%= slides.first[:item_number] %></a>
      <a data-slide-image-link href="<%= slides.first[:item_url] %>">
        <img src="<%= slides.first[:image_src] %>" alt="<%= slides.first[:image_alt] %>" data-slide-image>
      </a>
    </div>
  </section>

  <% if slides.size > 1 %>
    <script type="application/json" id="<%= carousel_id %>-data"><%== json_escape(slides.to_json) %></script>
    <script>
      (function () {
        const dataEl = document.getElementById('<%= carousel_id %>-data');
        if (!dataEl) return;
        const slides = JSON.parse(dataEl.textContent);
        let current = 0;

        const scope = document.getElementById('<%= carousel_id %>');
        const title = scope.querySelector('[data-slide-title]');
        const description = scope.querySelector('[data-slide-description]');
        const link = scope.querySelector('[data-slide-link]');
        const itemLink = scope.querySelector('[data-slide-item-link]');
        const imageLink = scope.querySelector('[data-slide-image-link]');
        const image = scope.querySelector('[data-slide-image]');
        const dots = scope.querySelectorAll('[data-carousel-dots] button');

        function setSlide(index) {
          current = (index + slides.length) % slides.length;
          const slide = slides[current];

          title.textContent = slide.title;
          description.textContent = slide.description || '';
          link.href = slide.search_url;
          itemLink.textContent = slide.item_number;
          itemLink.href = slide.item_url;
          imageLink.href = slide.item_url;
          image.src = slide.image_src;
          image.alt = slide.image_alt;

          dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === current));
        }

        scope.querySelector('[data-carousel-prev]')
          .addEventListener('click', () => setSlide(current - 1));
        scope.querySelector('[data-carousel-next]')
          .addEventListener('click', () => setSlide(current + 1));
        dots.forEach((dot, index) => dot.addEventListener('click', () => setSlide(index)));
      })();
    </script>
  <% end %>
<% end %>
