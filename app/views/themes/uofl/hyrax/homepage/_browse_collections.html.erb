<%# UOFL OVERRIDE: UofL Theme - "Browse Collections" grid (real collections,
    curated images) plus an Explore-by-type quick filter row. %>
<% cards = uofl_homepage_collection_slides(limit: 4) %>
<section class="browse-section">
  <% if cards.present? %>
    <div class="section-heading">
      <h2>Browse Collections</h2>
      <div id="all-collections-link">
        <%= link_to main_app.all_collections_path, class: 'plain-link' do %>
          All Collections <i class="fa-solid fa-arrow-right-long"></i>
        <% end %>
      </div>
    </div>

    <div class="collection-grid">
      <% cards.each do |card| %>
        <article class="collection-card">
          <img src="<%= card[:image_src] %>" alt="<%= card[:image_alt] %>">
          <div>
            <h3><%= link_to card[:title], card[:url] %></h3>
            <p><%= card[:description] %></p>
            <span class="item-count"><i class="fa-solid fa-images" aria-hidden="true"></i> <%= uofl_item_count_label(card[:count]) %></span>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

  <div class="type-filter" aria-label="Explore by type">
    <h2>Explore By Type</h2>
				  <a class="btn" href="/catalog?f_inclusive%5Bobject_type_sim%5D%5B%5D=Photographic+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Albumen+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Boudoir+card+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Cabinet+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Cabinet+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Carbon+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Cartes+de+visite&f_inclusive%5Bobject_type_sim%5D%5B%5D=Contact+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Contact+sheets&f_inclusive%5Bobject_type_sim%5D%5B%5D=Digital+images&f_inclusive%5Bobject_type_sim%5D%5B%5D=Dye+coupler+negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Film+negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Gelatin+silver+printing-out+paper+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Gelatin+silver+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Glass+negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Halftone+photomechanical+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Imperial+card+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Nitrate+negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Panel+card+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Photographic+postcards&f_inclusive%5Bobject_type_sim%5D%5B%5D=Photographic+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Photogravures&f_inclusive%5Bobject_type_sim%5D%5B%5D=Photomechanical+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Planographic+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Platinum+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Promenade+card+photographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Safety+film+negatives&f_inclusive%5Bobject_type_sim%5D%5B%5D=Silver+printing-out+paper+prints&f_inclusive%5Bobject_type_sim%5D%5B%5D=Slides&f_inclusive%5Bobject_type_sim%5D%5B%5D=Stereographs&f_inclusive%5Bobject_type_sim%5D%5B%5D=Tintypes&sort=score+desc%2C+system_create_dtsi+desc">Photographs</a>
