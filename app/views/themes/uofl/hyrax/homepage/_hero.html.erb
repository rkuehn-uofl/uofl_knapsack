<%# UOFL OVERRIDE: UofL Theme - Full-bleed homepage hero, replaces the old blank image-masthead banner.
    Image/alt text and the item-number button are resolved by
    UoflHomepageHelper#uofl_hero_image - see config/uofl_hero_images.yml
    for how the picture itself (weekly rotation, or a pinned override) is
    picked.

    fetchpriority="high" + eager loading + explicit dimensions tell the
    browser to fetch/decode this as the page's LCP element immediately,
    rather than discovering it only after CSS/layout - it's the single
    largest image on the page and always above the fold. width/height
    match every image in config/uofl_hero_images.yml (all 1800x1200);
    object-fit: cover (see .hero-image in uofl_home.scss) means they're
    just aspect-ratio hints, not the rendered size. %>
<% content_for(:extra_body_classes, ' has-hero ') %>
<% hero_image = uofl_hero_image %>
<section class="hero">
<img class="hero-image" alt="<%= hero_image[:image_alt] %>" src="<%= hero_image[:image_src] %>" width="1200" height="800" fetchpriority="high" loading="eager" decoding="async">
  <div class="hero-scrim"></div>
  <div class="hero-content">
    <h1>Explore<span>!</span></h1>
    <p class="hero-copy">
      <% if display_content_block?(@marketing_text) %>
        <%= displayable_content_block @marketing_text %>
      <% else %>
        Historic photographs, newspapers, books, maps, and more from our rare collections.
      <% end %>
    </p>

    <%= form_tag search_action_url, method: :get, class: 'hero-search search', id: 'hero-search-form', role: 'search' do %>
      <%= label_tag :hero_q, 'Search all digital collections', class: 'sr-only' %>
      <%= text_field_tag :q, current_search_parameters, id: 'hero_q', name: 'q', placeholder: 'Search all digital collections' %>
      <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
    <% end %>

    <div class="hero-buttons">
      <a class="adv-search" href="/advanced">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        Advanced Search
      </a>
      <% if has_facet_values? %>
        <button class="filter-launch" type="button" aria-haspopup="dialog" aria-controls="mySidebar2" aria-expanded="false" onclick="openNav(this)">
          <span class="filter-icon" aria-hidden="true"></span>
          Browse Items
        </button>
      <% end %>
    </div>
  </div>
  <% if hero_image[:item_url] %>
    <div class="hero-image-number"><a href="<%= hero_image[:item_url] %>"><%= hero_image[:item_number] %></a></div>
  <% end %>
</section>
