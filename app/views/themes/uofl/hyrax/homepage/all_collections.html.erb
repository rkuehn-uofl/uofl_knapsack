<%# UOFL OVERRIDE: UofL Theme - Display all viewable collections. %>
<%
  collection_browse_title = 'Browse by Collection'
  collection_browse_title += " - Letter #{@selected_collection_letter}" if @selected_collection_letter.present?
%>
<% provide :page_title, construct_page_title(uofl_page_title_with_page(collection_browse_title)) %>
<div class="home-collections-browse">
<div class="collections-list">
  <section>
    <div class="collection-search-and-filter">
      <%= form_with url: main_app.all_collections_path, method: :get, local: true, class: 'search' do |form| %>
        <%= hidden_field_tag :collection_letter, @selected_collection_letter if @selected_collection_letter.present? %>
        <%= hidden_field_tag :collection_sort, @selected_sort, id: nil if @selected_sort.present? %>
        <h2 class="sr-only"><%= form.label :collection_description_query, 'Search collection titles and descriptions' %></h2>
        <%= form.search_field :collection_description_query,
                              value: @collection_description_query,
                              placeholder: 'Search collection titles and descriptions',
                              aria: { label: 'Search collection titles and descriptions' } %>
        <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
      <% end %>
      <% if @collection_description_query.present? %>
        <%= link_to 'Clear search', main_app.all_collections_path(collection_letter: @selected_collection_letter.presence, collection_sort: @selected_sort), class: 'plain-link' %>
      <% end %>
    </div>
  </section>

  <section>
    <div class="browse-by-collection-name">
      <div><strong>Browse by name</strong></div>
      <nav class="alpha-nav" aria-label="Filter collections by first letter">
        <%= link_to 'All',
                    main_app.all_collections_path(collection_description_query: @collection_description_query.presence, collection_sort: @selected_sort),
                    class: @selected_collection_letter.blank? ? 'active' : nil %>
        <% ('A'..'Z').each do |letter| %>
          <% if @collection_letters.include?(letter) %>
            <%= link_to letter,
                        main_app.all_collections_path(collection_letter: letter, collection_description_query: @collection_description_query.presence, collection_sort: @selected_sort),
                        class: @selected_collection_letter == letter ? 'active' : nil %>
          <% else %>
            <span class="disabled" aria-disabled="true"><%= letter %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  </section>

  <section class="number-and-sort">
    <div class="number-of-collections"><%= pluralize(@total_collections_count, 'collection') %></div>
    <div class="sort-collections">
      <%# UOFL OVERRIDE: use Blacklight's own sort dropdown component -- the same
          button + dropdown-menu widget /catalog uses -- instead of a bare <select>
          inside a <form>, whose native browser behavior (implicit submit-on-Enter,
          OS-rendered popup) is unpredictable across browsers/AT.
          Options are pre-built with main_app-prefixed URLs (like every other link
          in this view) rather than left to the component's own url_for, since a
          plain url_for inside Hyrax::HomepageController resolves against the
          engine's routes and can't find this app's all_collections route. %>
      <% collection_sort_dropdown = Blacklight::System::DropdownComponent.new(
           param: 'collection_sort',
           choices: Hyrax::HomepageControllerDecorator::SORT_OPTIONS.map { |value, opts| [opts[:label], value] },
           search_state: nil,
           selected: @selected_sort
         )
         Hyrax::HomepageControllerDecorator::SORT_OPTIONS.each do |value, opts|
           collection_sort_dropdown.with_option(
             text: opts[:label],
             url: main_app.all_collections_path(collection_letter: @selected_collection_letter.presence, collection_description_query: @collection_description_query.presence, collection_sort: value),
             selected: @selected_sort == value
           )
         end %>
      <%= render collection_sort_dropdown %>

      <%# Same dropdown component as sort, for the per-page count. %>
      <% collection_per_page_dropdown = Blacklight::System::DropdownComponent.new(
           param: 'collection_per_page',
           choices: Hyrax::HomepageControllerDecorator::PER_PAGE_OPTIONS.map { |value| [value.to_s, value] },
           search_state: nil,
           selected: @selected_per_page
         )
         Hyrax::HomepageControllerDecorator::PER_PAGE_OPTIONS.each do |value|
           collection_per_page_dropdown.with_option(
             text: value.to_s,
             url: main_app.all_collections_path(collection_letter: @selected_collection_letter.presence, collection_description_query: @collection_description_query.presence, collection_sort: @selected_sort, collection_per_page: value),
             selected: @selected_per_page == value
           )
         end %>
      <%= render collection_per_page_dropdown %>
    </div>
  </section>

  <section class="collections-list">
    <div class="section-heading">
      <h2 class="sr-only">Collections List</h2>
    </div>

    <% if @collections.present? %>
      <div class="collection-grid">
        <% @collections.each do |collection| %>
          <article class="collection-card">
            <%= render_thumbnail_tag collection, { alt: thumbnail_alt_text_for(collection, block_name: 'default_collection_image_text') }, { suppress_link: true } %>
            <div>
              <h3><%= link_to markdown(collection.title_or_label), [hyrax, collection] %></h3>
              <% Array(collection.description).compact_blank.each do |description| %>
                <p><%= markdown(description) %></p>
              <% end %>
              <span class="item-count"><i class="fa-solid fa-images" aria-hidden="true"></i> <%= uofl_item_count_label(@collection_item_counts[collection.id.to_s]) %></span>
              <div class="coll-link">
                <%= link_to [hyrax, collection], class: 'btn btn-right-arrow' do %>
                  View Collection <span class="sr-only">[<%= collection.title_or_label %>]</span>
                  <i class="fa-solid fa-arrow-right"></i>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
      <%# UOFL OVERRIDE: build page links directly with the named route helper
          (same pattern as every other control on this page - the letter nav,
          sort dropdown, per-page dropdown) instead of Kaminari's `paginate`
          helper. Kaminari's own link generation goes through Hyrax's
          kaminari_engine_patch.rb, which calls url_for with a bare
          controller/action hash - that raises ActionController::UrlGenerationError
          for this route regardless of param_name (confirmed: fails identically
          with the default :page). Named route helpers don't have that problem. %>
      <% if @collections.total_pages > 1 %>
        <nav class="row record-padding col-md-9" aria-label="Collections pages">
          <% @collections.total_pages.times do |index| %>
            <% page_number = index + 1 %>
            <%= link_to page_number,
                        main_app.all_collections_path(
                          collection_letter: @selected_collection_letter.presence,
                          collection_description_query: @collection_description_query.presence,
                          collection_sort: @selected_sort,
                          collection_per_page: @selected_per_page,
                          Hyrax::HomepageControllerDecorator::PAGE_PARAM_NAME => page_number
                        ),
                        class: "page-link #{'active' if page_number == @collections.current_page}",
                        aria: (page_number == @collections.current_page ? { current: 'page' } : {}) %>
          <% end %>
        </nav>
      <% end %>
    <% else %>
      <p>No collections match the current filters.</p>
    <% end %>
  </section>
</div>
</div>