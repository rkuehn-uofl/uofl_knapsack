<%# UOFL OVERRIDE: hyrax-webapp's pdf.js viewer.html ships the toolbar Save button with a `hidden` class;
    strip it once the (same-origin) viewer loads so Save shows like stock pdf.js, and keep Open/Print/Save
    in the Tools menu at every width %>
<div class="viewer-wrapper">
  <iframe id="pdf-viewer" aria-label="image view"
    src="<%= pdf_js_url(hyrax.download_path(file_set_presenter.id)) %>"
    allowfullscreen="true"
    frameborder="0"
  ></iframe>
</div>
<script>
  (function() {
    var iframe = document.getElementById('pdf-viewer');
    function showDownload() {
      try {
        var button = iframe.contentDocument && iframe.contentDocument.getElementById('download');
        if (button) button.classList.remove('hidden');

        // pdf.js only lists Open/Print/Save in the Tools menu at narrow widths; show them at all widths
        if (iframe.contentDocument && !iframe.contentDocument.getElementById('uofl-pdf-menu-style')) {
          var style = iframe.contentDocument.createElement('style');
          style.id = 'uofl-pdf-menu-style';
          style.textContent = '#secondaryToolbar .visibleLargeView, #secondaryToolbar .visibleMediumView { display: inherit; }';
          iframe.contentDocument.head.appendChild(style);
        }
      } catch (e) {}
    }
    iframe.addEventListener('load', showDownload);
    showDownload();
  })();
</script>
