<%# UOFL OVERRIDE: Hyku 7.2.0 hyrax/base/_download_pdf.html.erb, plus a Download Text button when an uploaded .txt file set exists %>
<%# Like Hyku, the PDF button prefers the work's representative PDF (the one the PDF viewer shows) among PDFs the visitor can download. %>
<% pdf = pdf_file_set_presenter(presenter, downloadable: true) %>
<% text_file_set = presenter.file_set_presenters.find { |fs| fs.mime_type == 'text/plain' } %>
<% if presenter.file_set_presenters.any?(&:pdf?) %>
  <div class="download-pdf-controls">
    <% if pdf.present? %>
      <%= button_tag type: 'button',
                     id: "file_download",
                     data: { label: pdf.id,
                             path: hyrax.download_path(pdf) },
                     class: "btn btn-success btn-block file_download center-block",
                     onclick: "window.open(this.dataset.path, '_blank', 'noopener,noreferrer');" do %>
        <%= t('hyrax.base.download_pdf') %>
      <% end %>
    <% end %>
    <% if text_file_set && can?(:download, text_file_set.id) %>
      <%= button_tag type: 'button',
                     id: "file_download_text",
                     data: { label: text_file_set.id,
                             path: hyrax.download_path(text_file_set) },
                     class: "btn btn-success btn-block file_download center-block",
                     onclick: "window.open(this.dataset.path, '_blank', 'noopener,noreferrer');" do %>
        Download Text
      <% end %>
    <% end %>
  </div>
<% end %>
