<%# UOFL OVERRIDE: Hyku 7.2.0 hyrax/base/_attribute_rows.html.erb, with the loop from %>
<%# hyrax/base/_attribute_rows_list.html.erb inlined (rather than rendered) so UofL can %>
<%# insert a linked "Collection" row right after Source. Collection membership is a PCDM %>
<%# relationship, not a literal metadata property, so it can't be added via the flexible %>
<%# metadata (m3) schema - it has to be injected here instead. Keep the loop in sync with %>
<%# _attribute_rows_list.html.erb: it honors show_page/position/admin_only/editor_only %>
<%# (field_visible?), e.g. hiding the editor_only redirects row from the public. %>
<% field_order = %i[date_modified creator contributor subject publisher language identifier keyword
                    date_created based_near related_url resource_type source rights_statement
                    participants identifiers relationships] %>
<%# Same per-record check view_options_for uses: a record saved under the m3 profile follows the profile's fields and order whatever the app setting, so field_order applies only to YAML-schema records %>
<% fields = view_options_for(presenter) %>
<% profile_driven = presenter.respond_to?(:flexible?) && presenter.flexible? %>
<% fields = fields.slice(*field_order.map(&:to_s)) unless profile_driven %>
<% fields.each do |field, options| %>
  <%# Card-display compounds render separately via render_compound_cards, not inline %>
  <% next if compound_card_field?(presenter, field) %>
  <% render_field = conform_field(field, options) %>
  <%# A field with no reader (e.g. a compound with no entries, which is not indexed) is empty; skip it rather than log a missing-method warning %>
  <% next unless presenter.respond_to?(render_field) %>
  <% view_options = conform_options(field, options) %>
  <%# keeps admin_note behavior for backward compatibility... should be in metadata but may not be %>
  <% if field.to_sym == :admin_note %>
    <%= presenter.attribute_to_html(render_field, view_options) if presenter.editor? %>
  <% else %>
    <%= presenter.attribute_to_html(render_field, view_options) if field_visible?(view_options, presenter) %>
  <% end %>

  <% if field.to_sym == :source && presenter.respond_to?(:member_of_collection_presenters) && presenter.member_of_collection_presenters.present? %>
    <dt class="attribute-collection"><%= t('.collection', default: 'Collection') %></dt>
    <dd class="attribute attribute-collection">
      <ul class="tabular">
        <% presenter.member_of_collection_presenters.each do |collection| %>
          <li><%= link_to collection.title.first, hyrax.collection_path(collection.id) %></li>
        <% end %>
      </ul>
    </dd>
  <% end %>
<% end %>
<% unless Hyrax.config.flexible? %>
  <%# Copied from hyrax-doi v0.2.0 %>
  <%= presenter.attribute_to_html(:doi, render_as: :external_link, html_dl: true) if respond_to?(:render_doi?) && render_doi?(presenter) %>
<% end %>
